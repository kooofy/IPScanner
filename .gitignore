# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
env/

# 个人数据（本地生成的 MAC 地址库，含内部设备信息，不入库）
mac_library.db

# 本地生成的 OUI 数据库（含运行时 WAL 临时文件，不入库）
oui.db
oui.db-shm
oui.db-wal

# 用户导入的清单 / 导出结果（含内部信息，不入库）
*.xls
Downloads_*

# 系统 / 编辑器
.DS_Store
Thumbs.db
*.log
.workbuddy/
.workbuddy-ai/
.ruff_cache/

# 本地配置（用户偏好/窗口布局，不入库）
ipscanner.ini
scan_history.json
scan_history.db
scan_history.db-shm
scan_history.db-wal
audit_log.db
audit_log.db-shm
audit_log.db-wal
crash.log

# i18n 审计脚本生成的待翻译清单（工作产物，不入库）
i18n/_todo_*.json

# PyInstaller 构建产物
build/
dist/
dist_new/
# 只忽略 PyInstaller 自动生成的 spec（与入口脚本同名）。
# 手写的 IPScanner_*.spec 必须入库 —— 否则别人拿不到发布构建的配方，
# 也就无法复现出同一份 exe（hiddenimports / datas 全在里面）。
/main.spec
/cli.spec
