
QMainWindow {
    background-color: #F0F0F0;
}
QGroupBox {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
    font-weight: bold;
    color: #333333;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 14px;
    background-color: #FFFFFF;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}
QPushButton {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
    padding: 5px 14px;
    border-radius: 4px;
    border: 1px solid #ADADAD;
    background-color: #E1E1E1;
    color: #333333;
    min-height: 24px;
}
QPushButton:hover {
    background-color: #D0D0D0;
    border-color: #0078D7;
}
QPushButton:pressed {
    background-color: #C0C0C0;
}
QPushButton#primaryBtn {
    background-color: #F5F5F5;
    color: #333333;
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
    padding: 4px 14px;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
}
QPushButton#primaryBtn:hover {
    background-color: #EBEBEB;
}
QPushButton#primaryBtn:pressed {
    background-color: #DCDCDC;
}
QPushButton#primaryBtn:disabled {
    background-color: #FAFAFA;
    color: #DCDCDC;
    border-color: #EBEBEB;
}
QPushButton#stopBtn {
    background-color: #F5F5F5;
    color: #333333;
    font-family: "Microsoft YaHei", "Segoe UI";
    font-weight: bold;
    font-size: 13px;
    padding: 4px 14px;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
}
QPushButton#stopBtn:hover {
    background-color: #EBEBEB;
}
QPushButton#stopBtn:pressed {
    background-color: #DCDCDC;
}
QPushButton#stopBtn:disabled {
    background-color: #FAFAFA;
    color: #DCDCDC;
    border-color: #EBEBEB;
}
QPushButton#toolBtnGreen {
    background-color: #E8F5E9;
    color: #1B5E20;
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
    padding: 4px 12px;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
}
QFrame#toolSep {
    background-color: #D0D0D0;
    border: none;
}

QToolButton#presetBtn {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
    padding: 4px 10px;
    border: 1px solid #ADADAD;
    border-radius: 4px;
    background-color: #E1E1E1;
    color: #333333;
}
QToolButton#presetBtn:hover {
    background-color: #D0D0D0;
    border-color: #0078D7;
}
QToolButton#presetBtn::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    right: 3px;
}

/* 结果筛选条 chip（UI_REVIEW P1-4） */
QPushButton#filterChip {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 12px;
    padding: 2px 6px;
    min-height: 20px;
    border: 1px solid #C4C4C4;
    border-radius: 10px;
    background-color: #F5F5F5;
    color: #555555;
}
QPushButton#filterChip:hover {
    background-color: #EAEAEA;
    border-color: #0078D7;
}
QPushButton#filterChip:checked {
    background-color: #0078D7;
    border-color: #0078D7;
    color: #FFFFFF;
}
QPushButton#filterChip:focus {
    border-color: #0078D7;
}

/* 筛选条滚动容器（filter_bar.FilterChipScroll）：仅在 chip 放不下时出现。
   高度与 FilterChipScroll._BAR_EXTENT 保持一致，否则滚动条会盖住 chip 文字。 */
QScrollArea#filterScroll {
    background: transparent;
    border: none;
}
QScrollArea#filterScroll > QWidget > QWidget {
    background: transparent;
}
QScrollArea#filterScroll QScrollBar:horizontal {
    height: 10px;
    margin: 0;
    background: transparent;
}
QScrollArea#filterScroll QScrollBar::handle:horizontal {
    min-width: 24px;
    border-radius: 4px;
}
QScrollArea#filterScroll QScrollBar::add-line:horizontal,
QScrollArea#filterScroll QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: transparent;
}
QPushButton#toolBtnGreen:hover {
    background-color: #C8E6C9;
}
QPushButton#toolBtnGreen:pressed {
    background-color: #A5D6A7;
}
QPushButton#toolBtnYellow {
    background-color: #FFF9C4;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
}
QPushButton#toolBtnYellow:hover {
    background-color: #FFF59D;
}
QPushButton#toolBtnYellow:pressed {
    background-color: #FFF176;
}
QPushButton#dangerBtn {
    background-color: #E8E8E8;
    color: #D32F2F;
    border: 1px solid #D32F2F;
}
QPushButton#dangerBtn:hover {
    background-color: #FFEBEE;
}
QPushButton#dangerBtn:disabled {
    color: #BDBDBD;
    border-color: #BDBDBD;
}
QPushButton#successBtn {
    background-color: #E8F5E9;
    color: #2E7D32;
    border: 1px solid #2E7D32;
}
QPushButton#successBtn:hover {
    background-color: #C8E6C9;
}
QLineEdit {
    font-family: "Consolas", "Microsoft YaHei";
    font-size: 13px;
    padding: 4px 8px;
    border: 1px solid #ABABAB;
    border-radius: 4px;
    background-color: #FFFFFF;
    selection-background-color: #0078D7;
    min-height: 22px;
}
QLineEdit:focus {
    border: 1px solid #0078D7;
}
QComboBox {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
    padding: 4px 8px;
    border: 1px solid #ABABAB;
    border-radius: 4px;
    background-color: #FFFFFF;
    min-height: 22px;
}
QSpinBox {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
    padding: 4px 8px;
    border: 1px solid #ABABAB;
    border-radius: 4px;
    background-color: #FFFFFF;
    min-height: 22px;
}
QCheckBox {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
    color: #333333;
}
QLabel {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
    color: #333333;
}
QTreeWidget {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
    color: #000000;
    gridline-color: #E8E8E8;
    background-color: #FFFFFF;
    alternate-background-color: #F7F7F7;
    border: 1px solid #CCCCCC;
    border-radius: 0px;
    selection-background-color: #CCE8FF;
    selection-color: #000000;
}
/* 键盘用户必须看得出焦点在哪：去掉逐项的虚线框，改为容器级焦点边框
   （原实现是 `outline: 0` 一刀切，键盘导航时完全没有视觉反馈） */
QTreeWidget::item:focus {
    outline: none;
}
QTreeWidget:focus {
    border: 1px solid #0078D7;
}
QTreeWidget::item {
    padding: 4px 6px;
    border: none;
    min-height: 26px;
}
/* 行高两档（UI_REVIEW P2-1.2）。属性值由 `MainWindow._apply_row_density()` 设置，
   ⚠️ 动态属性改了**必须** unpolish/polish 才会重绘 —— 否则切档位没反应。
   数字必须与 `design_tokens.ROW_HEIGHT` / `ROW_PADDING_V` 一致，由 test_design_tokens 校验。
   ⚠️ 紧凑档必须**同时收 padding**：min-height 压不过字号本身的行高 —— 实测把它
   从 26 降到 20，行高只从 34px 降到 29px；连 padding 收到 2px 才是 25px。 */
QTreeWidget#resultTable[density="comfortable"]::item {
    padding: 4px 6px;
    min-height: 26px;
}
QTreeWidget#resultTable[density="compact"]::item {
    padding: 2px 6px;
    min-height: 20px;
}
QTreeWidget::item:hover {
    background-color: #E5F3FF;
}
QTreeWidget::item:selected {
    background-color: #CCE8FF;
    color: #000000;
}
QTreeWidget::branch {
    width: 16px;
}
QHeaderView::section {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
    font-weight: bold;
    color: #000000;
    background-color: #E8E8E8;
    border: none;
    border-right: 1px solid #CCCCCC;
    border-bottom: 1px solid #CCCCCC;
    padding: 5px 8px;
}
QHeaderView::section:hover {
    background-color: #D8D8D8;
}
QProgressBar {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 12px;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    background-color: #E8E8E8;
    text-align: center;
    color: #333333;
    height: 20px;
}
QProgressBar::chunk {
    background-color: #0078D7;
    border-radius: 0px;
}
QStatusBar {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 12px;
    color: #555555;
    background-color: #F0F0F0;
    border-top: 1px solid #CCCCCC;
}
QListWidget {
    font-family: "Consolas", "Microsoft YaHei";
    font-size: 13px;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    background-color: #FFFFFF;
    padding: 1px;
}
QListWidget::item {
    padding: 3px 5px;
    border-radius: 2px;
}
QListWidget::item:hover {
    background-color: #E5F3FF;
}
QMenuBar {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 14px;
    background-color: #F0F0F0;
    border: none;
    padding: 2px 0px;
    spacing: 0px;
}
QMenuBar::item {
    padding: 5px 8px;
    background-color: transparent;
    border-radius: 0px;
    border: none;
}
QMenuBar::item:selected {
    background-color: #D0E8FF;
    border: none;
}
QMenuBar::item:pressed {
    background-color: #B0D8FF;
    border: none;
}
QMenu {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
    border: 1px solid #A0A0A0;
    background-color: #F5F5F5;
    padding: 2px 0px;
    border-radius: 0px;
}
QMenu::separator {
    height: 1px;
    margin: 3px 6px 3px 32px;
    background-color: #C8C8C8;
}
QMenu::item {
    padding: 5px 28px 5px 6px;
    background-color: transparent;
    min-width: 200px;
    max-width: 380px;
    border: none;
}
QMenu::icon {
    background-color: #E0E0E0;
    border-right: 1px solid #C0C0C0;
    margin: 0px;
    padding: 4px 5px;
    width: 24px;
    height: 24px;
}
QMenu::item:selected {
    background-color: #0078D7;
    color: #FFFFFF;
    border: none;
}
QMenu::item:disabled {
    color: #808080;
    background-color: transparent;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 4px;
}
QMenu::right-arrow {
    width: 14px;
    height: 14px;
    padding-right: 6px;
}
QScrollBar:vertical {
    border: none;
    background: #F0F0F0;
    width: 12px;
    border-radius: 0px;
}
QScrollBar::handle:vertical {
    background: #C0C0C0;
    border-radius: 0px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #A0A0A0;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    border: none;
    background: #F0F0F0;
    height: 12px;
    border-radius: 0px;
}
QScrollBar::handle:horizontal {
    background: #C0C0C0;
    border-radius: 0px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #A0A0A0;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QToolTip {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 12px;
    background-color: #FFFFCC;
    color: #333333;
    border: 1px solid #999999;
    padding: 3px 6px;
}

/* ── 结果区主从布局：详情面板 / 空状态 / 分隔条 (UI_REVIEW P0-1 / P0-2) ── */

QSplitter#detailSplitter::handle {
    background-color: #E4E4E4;
    height: 4px;
}
QSplitter#detailSplitter::handle:hover {
    background-color: #0078D7;
}

QWidget#detailPanel {
    background-color: #FFFFFF;
    border-top: 1px solid #CCCCCC;
}
QLabel#detailTitle {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
    font-weight: bold;
    color: #0078D7;
}
QFrame#detailSep {
    background-color: #E4E4E4;
    border: none;
}
QLabel#detailSection {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 11px;
    font-weight: bold;
    color: #0078D7;
    padding-top: 4px;
}
QLabel#detailLabel {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 12px;
    color: #8A8A8A;
}
QLabel#detailValue {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 12px;
    color: #222222;
}
QLabel#detailHint {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 12px;
    color: #9A9A9A;
}
QPushButton#detailAction {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 12px;
    padding: 3px 10px;
    min-height: 20px;
    border: 1px solid #ADADAD;
    border-radius: 4px;
    background-color: #F0F0F0;
    color: #333333;
}
QPushButton#detailAction:hover {
    background-color: #E2E2E2;
    border-color: #0078D7;
}

QWidget#emptyState {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
}
QLabel#emptyTitle {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 18px;
    color: #333333;
}
QLabel#emptySubtitle {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
    color: #666666;
}
QLabel#emptyHint {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 12px;
    color: #8A8A8A;
}
QPushButton#emptySecondary {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
    padding: 5px 14px;
    border: 1px solid #ADADAD;
    border-radius: 4px;
    background-color: #E1E1E1;
    color: #333333;
}
QPushButton#emptySecondary:hover {
    background-color: #D0D0D0;
    border-color: #0078D7;
}

/* 状态栏 / 工具栏上的内联样式标签，统一收到 QSS（UI_REVIEW P2-2） */
QLabel#rangeCountLabel {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 11px;
    font-weight: bold;
    color: #0078D7;
}
QLabel#statsLabel {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 12px;
    color: #555555;
}
QLabel#libraryLabel {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 11px;
    color: #888888;
}
QFrame#hSep {
    background-color: #CCCCCC;
    border: none;
}

/* ── 结果视图切换（列表 / 概览）── */
QWidget#viewToggle {
    background: transparent;
}
QPushButton#viewBtn {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 12px;
    padding: 2px 10px;
    min-height: 20px;
    border: 1px solid #C4C4C4;
    border-radius: 4px;
    background-color: #F5F5F5;
    color: #555555;
}
QPushButton#viewBtn:hover {
    background-color: #EAEAEA;
    border-color: #0078D7;
}
QPushButton#viewBtn:checked {
    background-color: #0078D7;
    border-color: #0078D7;
    color: #FFFFFF;
}
QPushButton#viewBtn:focus {
    border-color: #0078D7;
}

/* ── 概览仪表盘（overview.py）── */
QWidget#overviewPanel {
    background-color: #FFFFFF;
}
QLabel#overviewTitle {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 15px;
    font-weight: bold;
    color: #333333;
}
QLabel#overviewScope {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 11px;
    color: #888888;
}
QFrame#statCard {
    background-color: #F7F9FB;
    border: 1px solid #E1E6EB;
    border-radius: 4px;
}
QLabel#statValue {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 20px;
    font-weight: bold;
    color: #333333;
}
QLabel#statValue[tone="online"] {
    color: #16A34A;
}
QLabel#statValue[tone="offline"] {
    color: #DC2626;
}
QLabel#statValue[tone="accent"] {
    color: #0078D7;
}
QLabel#statLabel {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 11px;
    color: #64748B;
}
QFrame#overviewBlock {
    background-color: #FBFCFD;
    border: 1px solid #E8ECF0;
    border-radius: 4px;
}
QLabel#overviewBlockTitle {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 12px;
    font-weight: bold;
    color: #555555;
}
QLabel#overviewName {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 11px;
    color: #333333;
}
QLabel#overviewCount {
    font-family: "Consolas", "Microsoft YaHei";
    font-size: 11px;
    color: #333333;
}
QLabel#overviewCount[tone="warn"] {
    color: #D97706;
    font-weight: bold;
}
QLabel#overviewCount[tone="bad"] {
    color: #DC2626;
    font-weight: bold;
}
QLabel#overviewHint {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 11px;
    color: #888888;
}
QProgressBar#overviewBar {
    background-color: #E8ECF0;
    border: none;
    border-radius: 4px;
}
QProgressBar#overviewBar::chunk {
    background-color: #0078D7;
    border-radius: 4px;
}
QProgressBar#overviewBar[tone="good"]::chunk {
    background-color: #16A34A;
}
QProgressBar#overviewBar[tone="warn"]::chunk {
    background-color: #D97706;
}
QProgressBar#overviewBar[tone="bad"]::chunk {
    background-color: #DC2626;
}

/* ── 批次 3：对话框说明文字 + 空状态主按钮 ────────────────────
   下面这几类标签原先在 Python 里 `setStyleSheet("color: #666; …")` 硬编码，
   深色主题下不会跟着变（深灰压在深底上几乎不可见）。收回 QSS 后随主题自动
   切换，色值与 `theme_tokens` 的 `muted` 保持一致。 */
QLabel#dialogHint {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 12px;
    color: #64748B;
}
QLabel#dialogHintSmall {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 11px;
    color: #64748B;
}
QLabel#snmpTestResult {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 11px;
    color: #64748B;
}
QLabel#snmpTestResult[ok="true"] {
    color: #16A34A;
}
QLabel#snmpTestResult[ok="false"] {
    color: #DC2626;
}
/* 空状态主 CTA：实心强调色。此前它与次要按钮同为浅灰底，"哪个才是推荐动作"
   完全看不出来（UI_REVIEW_ROUND2 §5 第 9 项）。 */
QPushButton#emptyPrimary {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
    font-weight: bold;
    padding: 5px 16px;
    border: 1px solid #0078D7;
    border-radius: 4px;
    background-color: #0078D7;
    color: #FFFFFF;
}
QPushButton#emptyPrimary:hover {
    background-color: #1A88E0;
    border-color: #1A88E0;
}
QPushButton#emptyPrimary:pressed {
    background-color: #0069BC;
    border-color: #0069BC;
}
/* 扫描态摘要条（UI_REVIEW P0-2 后半）：扫描期间显示
   「阶段 / 进度 / 已扫 / 在线 / 有服务 / 用时 / 停止」。 */
QFrame#scanStatusBar {
    background-color: #F2F7FD;
    border: 1px solid #D6E4F0;
    border-radius: 4px;
}
QLabel#scanPhase {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 12px;
    font-weight: bold;
    color: #005A9E;
}
QLabel#scanMetric {
    font-family: "Consolas", "Microsoft YaHei";
    font-size: 12px;
    color: #333333;
}
QProgressBar#scanProgress {
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    background-color: #E8E8E8;
}
QProgressBar#scanProgress::chunk {
    border-radius: 2px;
    background-color: #0078D7;
}
QPushButton#scanStop {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 12px;
    padding: 2px 10px;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    background-color: #F0F0F0;
    color: #333333;
}
QPushButton#scanStop:hover {
    background-color: #E0E0E0;
}
